{
    "env": {
        "browser": true,
        "es6": true,
        "node": true
    },
    "parser": "@babel/eslint-parser",
    "parserOptions": {
        "ecmaVersion": 8,
        "requireConfigFile": false,
        "sourceType": "module",
        "ecmaFeatures": {
            "jsx": true,
            "js": true,
            "modules": true,
            "experimentalObjectRestSpread": true
        }
    },
    "plugins": ["react"],
    "extends": [
        "eslint:recommended",
        "plugin:prettier/recommended",
        "plugin:react/recommended"
    ],
    "rules": {
        "react/prop-types": "off",
        "react/no-unescaped-entities": 0,
        "no-unused-vars": "error",
        "no-undef": "error",
        "no-redeclare": "error",
        "no-unreachable": "error",
        "no-duplicate-imports": "error",
        "no-console": "warn",
        "prefer-const": "error",
        "arrow-body-style": ["error", "as-needed"],
        "arrow-parens": ["error", "as-needed"],
        "consistent-return": "error",
        "eqeqeq": ["error", "always"],
        "curly": ["error", "all"],
        "complexity": ["error", {"max": 10}],
        "max-depth": ["error", {"max": 3}],
        "no-var": "error",
        "prefer-template": "error",
        "prettier/prettier": [
            "warn",
            {
                "endOfLine": "auto",
                "trailingComma": "es5",
                "semi": true,
                "singleQuote": true,
                "tabWidth": 4,
                "useTabs": false,
                "printWidth": 160,
                "jsxBracketSameLine": true,
                "arrowParens": "avoid"
            }
        ]
    },
    "settings": {
        "react": {
            "version": "^18.2.0"
        }
    }
}
