{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AppSettings": {
    "StaticDomain": ""
  },
  "Sentry": {
    "Dsn": "",
    "Environment": "UAT",
    "MinimumBreadcrumbLevel": "Information",
    "MinimumEventLevel": "Error",
    "MaxBreadcrumbs": 50,
    "SendDefaultPii": true,
    "MaxRequestBodySize": "Always"
  },
  "UseErrorHandler": "1"
}
